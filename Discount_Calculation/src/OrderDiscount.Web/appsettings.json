{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "System": "Warning" } },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "logs/order-discount-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14, "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "DiscountSettings": {
    "Rates": { "Regular": 0.05, "Premium": 0.10, "VIP": 0.15 },
    "Rounding": { "DecimalPlaces": 2, "Mode": "AwayFromZero" }
  },
  "DatabaseSettings": {
    "Enabled": false,
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost;Database=OrderDiscountDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AuthSettings": {
    "Mode": "Bypass",
    "ActiveProvider": "Keycloak",
    "LocalUser": { "Subject": "local-dev-01", "Name": "Local Developer", "Role": "Orders.Write" },
    "Providers": {
      "Keycloak": { "Authority": "http://localhost:8080/realms/orders", "Audience": "order-discount-api", "RequireHttpsMetadata": false },
      "EntraId": { "Authority": "https://microsoftonline.com<tenant-id>/v2.0", "Audience": "api://order-discount-api", "RequireHttpsMetadata": true },
      "Auth0": { "Authority": "https://<tenant>://", "Audience": "https://order-discount-api", "RequireHttpsMetadata": true }
    }
  },
  "AllowedHosts": "*"
}