{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OrderDiscount.Web (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OrderDiscount.Web/bin/Debug/net10.0/OrderDiscount.Web.dll",
      "cwd": "${workspaceFolder}/src/OrderDiscount.Web",
      "serverReadyAction": { "action": "openExternally", "pattern": "\\bNow listening on:\\s+(https?://\\S+)" },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5000" }
    }
  ]
}